          "kind": "code",
          "caption": "A basic binary **tree** **node**.",
          "variants": {
            "python": {
              "code": "class TreeNode:\n    def __init__(self, value):\n        self.value = value\n        self.left = None\n        self.right = None",
              "output": ""
            },
            "java": {
              "code": "class TreeNode {\n    int value;\n    TreeNode left;\n    TreeNode right;\n\n    TreeNode(int value) {\n        this.value = value;\n    }\n}",
              "output": ""
            },
            "javascript": {
              "code": "class TreeNode {\n  constructor(value) {\n    this.value = value;\n    this.left = null;\n    this.right = null;\n  }\n}",
              "output": ""
            },
            "cpp": {
              "code": "struct TreeNode {\n    long long value;\n    TreeNode* left;\n    TreeNode* right;\n\n    TreeNode(long long value) : value(value), left(nullptr), right(nullptr) {}\n};",
