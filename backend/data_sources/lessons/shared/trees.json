{
  "_note": "Original advanced lesson. Uses language-specific block variants where syntax differs.",
  "title": "Trees",
  "summary": "A **tree** stores **nodes** in parent-child relationships. Many tree problems repeat the same work on left and right children.",
  "minutes": 22,
  "error_classes": [
    "wrong_answer",
    "runtime"
  ],
  "refresher": "A binary tree **node** stores a **value** plus left and right child links. **Traversal** means visiting nodes in a chosen order. Most recursive tree **functions** start with a **null check**.",
  "refresher_code": "if node is None: return base_answer\nsolve(node.left)\nsolve(node.right)",
  "learn_cards": {
    "advanced-tree-root": {
      "title": "Root is the starting node",
      "body": "The **root** is the top **node** of the tree. **Traversal** usually begins there.",
      "example": "root -> left child and right child",
      "notice": "A missing **root** means the **tree** is empty.",
      "mistake": "Do not confuse **root** with **leaf**. A root can have children.",
      "section_id": "tree-node"
    },
    "advanced-tree-leaf": {
      "title": "Leaf means no children",
      "body": "A **leaf** **node** has no left or right child.",
      "example": "node.left is null and node.right is null",
      "notice": "**Leaves** are where many recursive paths stop.",
      "mistake": "A **node** with one child is not a **leaf**.",
      "section_id": "tree-node"
    }
  },
  "sections": [
    {
      "id": "tree-node",
      "title": "Tree node shape",
      "summary": "A binary **tree** **node** has a value, left child, and right child.",
